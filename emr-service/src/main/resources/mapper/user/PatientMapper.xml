<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.usc.quzhijie.emrservice.user.mapper.PatientMapper">
    <select id="getPatientsByUid" resultType="PatientExp">
        select *
        from patient_exp
        where belonging_uid = #{uid}
    </select>

    <select id="getPatientById" resultType="PatientExp">
        select *
        from patient_exp
        where belonging_uid = #{belongingUid}
        and patient_id = #{patientId}
    </select>
</mapper>