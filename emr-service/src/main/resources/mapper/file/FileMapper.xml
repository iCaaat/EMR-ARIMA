<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.usc.quzhijie.emrservice.file.mapper.FileMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into file_info (id, original_name, file_name, file_path, file_size, file_type, create_time)
        values (#{id}, #{originalName}, #{fileName}, #{filePath}, #{fileSize}, #{fileType}, now())
    </insert>

    <select id="selectById" resultType="FileInfo">
        select * from file_info where id = #{id}
    </select>

    <delete id="deleteById">
        delete from file_info where id = #{id}
    </delete>
</mapper>